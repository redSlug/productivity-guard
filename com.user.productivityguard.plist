<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.productivityguard</string>

    <!-- Absolute path, not just "python3": launchd runs this with its own
         minimal PATH (no ~/.zshrc, no Homebrew on PATH), so a bare "python3"
         would silently resolve to Apple's old CLT-bundled interpreter (or
         nothing) instead of this one. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>__SCRIPT_PATH__</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Without this, launchd kills the entire process group (including
         the backgrounded `osascript` dialog in notify()) the instant this
         script exits, so warning dialogs never get a chance to render. -->
    <key>AbandonProcessGroup</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/com.user.productivityguard.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.user.productivityguard.err.log</string>
</dict>
</plist>
